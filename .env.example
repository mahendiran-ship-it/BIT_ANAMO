# Bitcoin Blockchain Intelligence Platform Configuration
BITCOIN_DATA_PROVIDER=mempool
BITCOIN_API_BASE=https://mempool.space/api
BITCOIN_WS_BASE=wss://mempool.space/api/v1/ws
BITCOIN_API_KEY=

# Maximum transactions to ingest and analyze per block (e.g. 500, 1000, 1500)
MAX_TRANSACTIONS_PER_BLOCK=1000

# Polling interval in seconds for block detection fallback
POLL_INTERVAL_SECONDS=20

# SQLite Database Location
DATABASE_URL=sqlite:///./bitcoin_intel.db

# Rolling Window in Days
ROLLING_WINDOW_DAYS=10

# AI Configuration (backend-only; never expose these values to Vite)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
GEMINI_API_KEY=
QWEN_API_KEY=
